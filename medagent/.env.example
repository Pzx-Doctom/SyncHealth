# ===== MedAgent Hub 环境变量模板 =====

# 应用
APP_NAME=MedAgent Hub
DEBUG=true
API_V1_PREFIX=/api/v1

# 独立数据库（medagent.db）
DATABASE_URL=sqlite+aiosqlite:///./data/medagent.db

# JWT（必须与 SyncHealth backend 保持一致，以便复用认证）
SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256

# SyncHealth MCP Server 地址
SYNCHEALTH_BASE_URL=http://localhost:8000
SYNCHEALTH_MCP_TOKEN=

# LLM Provider（与 backend 一致，复用 DeepSeek）
AI_PROVIDER=domestic
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TEMPERATURE=0.7

# 多模态 OCR 模型（用于药盒/报告图片识别）
VISION_MODEL=deepseek-chat

# ChromaDB 持久化目录
CHROMA_PERSIST_DIR=./data/chroma

# 嵌入模型（用于长期记忆向量化）- 硅基流动 SiliconFlow（OpenAI 兼容，注册送免费额度）
# 注册地址：https://cloud.siliconflow.cn
# 其他可选国产嵌入：
#   - 阿里 DashScope: EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1, EMBEDDING_MODEL=text-embedding-v3
#   - 智谱 GLM: EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4, EMBEDDING_MODEL=embedding-3
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=

# 地图 API（高德地图，用于附近医院/药店查询）
AMAP_API_KEY=

# 循环控制
MAX_LOOPS=5

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:3001"]
